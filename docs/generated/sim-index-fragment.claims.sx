  (primary [row Route(RouteRecord { id: RouteId("route/carry-a-wasm-library"), title: "Carry a wasm library across an explicit host boundary", audiences: ["code", "framework"], steps: [Feature { id: FeatureId("feature/sim-codecs/wasm-abi-contract"), why: "The ABI row owns inert manifests, byte frames, imports, and exports while the selected platform loader retains host authority." }, Specimen { id: SpecimenId("spec-test/sim-codecs/crates/sim-wasm-abi/src/tests/roundtrip"), why: "The checked round-trip specimen proves ABI records remain pure data." }, Specimen { id: SpecimenId("spec-test/sim-codecs/crates/sim-codec-compare/src/platform_roundtrip_tests"), why: "The cross-platform specimen proves the same contract survives platform codec projection." }], doc_anchor: None })] [note "route/carry-a-wasm-library"] [section "route"])
  (primary [row Route(RouteRecord { id: RouteId("route/encode-openai-provider-wire"), title: "Encode canonical model traffic for an OpenAI provider wire", audiences: ["code", "framework"], steps: [Feature { id: FeatureId("feature/sim-codecs/openai-provider-wires"), why: "The wire row selects Chat Completions or Responses while preserving one canonical bounded model contract." }, Specimen { id: SpecimenId("spec-test/sim-codecs/crates/sim-codec-chat/src/tests/openai_responses"), why: "The checked specimen covers Responses requests, responses, SSE events, and provider-private reasoning payloads." }], doc_anchor: None })] [note "route/encode-openai-provider-wire"] [section "route"])
  (primary [row Route(RouteRecord { id: RouteId("route/find-a-grammar"), title: "Find a grammar", audiences: ["code", "framework"], steps: [Feature { id: FeatureId("feature/sim-codecs/expression-syntax-grammars"), why: "The expression syntax row carries language and grammar subjects." }, Feature { id: FeatureId("feature/sim-codecs/domain-syntax-grammars"), why: "The domain syntax row carries data, document, config, and packet syntax contracts." }, Feature { id: FeatureId("feature/sim-codecs/wire-protocol-grammars"), why: "The wire row carries packet and byte-level grammar contracts." }], doc_anchor: None })] [note "route/find-a-grammar"] [section "route"])
  (primary [row Route(RouteRecord { id: RouteId("route/inspect-jvm-classfile"), title: "Inspect or extend JVM classfile structure", audiences: ["code", "framework"], steps: [Feature { id: FeatureId("feature/sim-codecs/classfile-inspection"), why: "The classfile codec is the sole byte parser and publishes manifest-derived opcode, constant, and attribute coverage." }, Specimen { id: SpecimenId("recipe/sim-codecs/crates/sim-codec-classfile/01-inspection/retained-classfile"), why: "The recipe demonstrates bounded JVM-free inspection with retained origins." }, Specimen { id: SpecimenId("spec-test/sim-codecs/crates/sim-codec-classfile/tests/index_coverage"), why: "The guard fixture proves duplicate inventories, consumer byte parsers, lossy modified UTF-8, and hand-edited generated coverage fail closed." }], doc_anchor: None })] [note "route/inspect-jvm-classfile"] [section "route"])
  (primary [row Route(RouteRecord { id: RouteId("route/interpret-saved-web-documents"), title: "Interpret saved HTML, feeds, and robots", audiences: ["code", "framework"], steps: [Feature { id: FeatureId("feature/sim-codecs/saved-web-documents"), why: "The codec organ owns bounded inert parsing and projections for all three saved web formats." }, Specimen { id: SpecimenId("spec-test/sim-codecs/crates/sim-codec-doc/src/html"), why: "The checked document specimen proves bounded inert HTML decoding into the shared document model." }], doc_anchor: None })] [note "route/interpret-saved-web-documents"] [section "route"])
  (primary [row Route(RouteRecord { id: RouteId("route/parse-javascript-source"), title: "Parse bounded JavaScript source", audiences: ["code", "framework"], steps: [Feature { id: FeatureId("feature/sim-codecs/javascript-source-frontend"), why: "The JavaScript frontend owns bounded ECMAScript tokenization, structural parsing, source identity, and expression lowering." }, Specimen { id: SpecimenId("spec-test/sim-codecs/crates/sim-codec-javascript/tests/conformance"), why: "The conformance specimen checks accepted syntax, stable lowering, round trips, and fail-closed limits." }], doc_anchor: None })] [note "route/parse-javascript-source"] [section "route"])
  (primary [row Route(RouteRecord { id: RouteId("route/parse-operator-language"), title: "Parse an operator language", audiences: ["code", "framework"], steps: [Feature { id: FeatureId("feature/sim-codecs/pratt"), why: "The Pratt codec is the operator-language parser surface." }], doc_anchor: None })] [note "route/parse-operator-language"] [section "route"])
  (primary [row Route(RouteRecord { id: RouteId("route/parse-python-source"), title: "Parse bounded Python source", audiences: ["code", "framework"], steps: [Feature { id: FeatureId("feature/sim-codecs/python-source-frontend"), why: "The Python frontend owns bounded Python tokenization, layout, source identity, and expression lowering." }, Specimen { id: SpecimenId("spec-test/sim-codecs/crates/sim-codec-python/src/tests"), why: "The conformance specimen checks admitted syntax, stable lowering, round trips, and fail-closed limits." }], doc_anchor: None })] [note "route/parse-python-source"] [section "route"])
